{
  "expo": {
    "name": "Unloq",
    "slug": "loqlearn",
    "version": "2.0.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#06050A"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.loqlearn.app",
      "buildNumber": "62",
      "minimumOsVersion": "16.0",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Unloq uses the camera to let you capture notes and documents for your study sessions.",
        "NSMicrophoneUsageDescription": "Unloq uses the microphone so you can explain what you learned out loud to Glim.",
        "NSPhotoLibraryUsageDescription": "Unloq accesses your photo library so you can upload images as study material."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#06050A",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "package": "com.loqlearn.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "loqlearn",
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#06050A",
          "dark": {
            "backgroundColor": "#06050A"
          }
        }
      ],
      "expo-font",
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      "./plugins/withFamilyControls",
      "expo-apple-authentication",
      "expo-web-browser",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Unloq uses the microphone so you can explain what you learned out loud to Glim."
        }
      ],
      "expo-audio",
      "expo-video"
    ],
    "extra": {
      "eas": {
        "projectId": "40156d1d-55bf-4586-aa26-ed9ea0cb89d7"
      }
    }
  }
}
